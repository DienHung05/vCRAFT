{
  "name": "vcraft",
  "private": true,
  "description": "vCraft — Tinh hoa làng nghề, muôn phương lan tỏa. Nền tảng triển lãm số, truy xuất nguồn gốc và điều phối đơn hàng cho làng nghề truyền thống.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e --filter=@vcraft/e2e",
    "db:migrate": "turbo run db:migrate --filter=@vcraft/database",
    "db:seed": "turbo run db:seed --filter=@vcraft/database",
    "infra:up": "docker compose -f infra/compose/compose.dev.yml up -d",
    "infra:down": "docker compose -f infra/compose/compose.dev.yml down",
    "deps:check": "depcruise apps packages --config .dependency-cruiser.cjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "dependency-cruiser": "^18.7.0",
    "lefthook": "^2.2.2",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2"
  }
}
