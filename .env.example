# ---------- Chung ----------
NODE_ENV=development
APP_URL=http://localhost:8080            # origin công khai (Caddy) — dùng để sinh URL trong mã QR
TZ=Asia/Ho_Chi_Minh

# ---------- Database (độc lập CSDL: đổi driver là đổi CSDL) ----------
DB_DRIVER=postgresql                     # postgresql | mysql
DB_HOST=localhost
DB_PORT=5432                             # mysql: 3306
DB_NAME=vcraft
DB_USER=vcraft
DB_PASSWORD=vcraft

# ---------- Redis (cache, BullMQ, pub/sub SSE) ----------
REDIS_URL=redis://localhost:6379

# ---------- Object storage (MinIO dev / Cloudflare R2 prod) ----------
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY=vcraft
S3_SECRET_KEY=vcraft-secret
S3_BUCKET_PUBLIC=vcraft-media
S3_BUCKET_PRIVATE=vcraft-private
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/vcraft-media

# ---------- Bảo mật ----------
JWT_ACCESS_PRIVATE_KEY=                  # Ed25519 PEM (sinh bằng infra/scripts/gen-keys.sh)
JWT_ACCESS_PUBLIC_KEY=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
FIELD_ENCRYPTION_KEYS=v1:base64key       # AES-256-GCM, hỗ trợ xoay khóa "v2:...,v1:..."

# ---------- Mail ----------
SMTP_URL=smtp://localhost:1025           # Mailpit khi dev
MAIL_FROM="vCraft <no-reply@vcraft.local>"

# ---------- Bản đồ ----------
NEXT_PUBLIC_MAP_STYLE_URL=/map/style.json
NEXT_PUBLIC_MAP_CENTER=105.9139,20.9758   # Bát Tràng (lng,lat)

# ---------- Tùy chọn (Could) ----------
ANTHROPIC_API_KEY=                       # gợi ý viết câu chuyện / dịch vi→en
