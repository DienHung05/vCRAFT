# ---------- Chung ----------
NODE_ENV=development
APP_URL=http://localhost:8080            # origin công khai (Caddy) — dùng để sinh URL trong mã QR
NEXT_PUBLIC_SITE_URL=http://localhost:8080   # origin công khai của web, nhúng vào QR /q/<code> lúc build (bỏ trống: dev localhost:3000)
TZ=Asia/Ho_Chi_Minh

# ---------- Database: Postgres của Supabase qua Session pooler (ADR-15) ----------
# Lấy ở Dashboard → Connect → Session pooler. Kiểm chứng MySQL: xem README.
DB_DRIVER=postgresql                     # postgresql | mysql
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=5432                             # mysql: 3306
DB_NAME=postgres
DB_USER=postgres.<project-ref>
DB_PASSWORD=                             # mật khẩu database Supabase, không commit
DB_SSL=true                              # mysql cục bộ: false
# DB_SSL=true luôn xác thực chứng chỉ máy chủ (không có tùy chọn tắt). Pooler của Supabase dùng CA riêng (Supabase Root 2021 CA).
# Chứng chỉ CA là công khai và đã nằm trong repo: infra/certs/supabase-root-2021.crt. Đường dẫn tương đối tính từ thư mục
# chạy lệnh (packages/database, apps/api, apps/worker đều cách gốc repo hai cấp) nên dùng ../../infra/certs/...
# Chỉ đặt MỘT trong hai (bỏ trống khi máy chủ dùng chứng chỉ của CA công khai, vd. Postgres cục bộ không TLS):
DB_SSL_CA_FILE=../../infra/certs/supabase-root-2021.crt   # đường dẫn file PEM; dự án Supabase khác/CA đổi: Dashboard → Database → Settings → SSL Configuration → Download certificate
DB_SSL_CA=                               # hoặc nội dung PEM (xuống dòng viết thành \n khi để một dòng)

# ---------- Redis (cache, BullMQ, pub/sub SSE) ----------
REDIS_URL=redis://localhost:6379

# ---------- Object storage (Supabase Storage qua giao thức S3, ADR-14) ----------
STORAGE_DRIVER=s3                        # s3 | local (test, CI, demo offline: ghi vào infra/compose/.data/media)
S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_REGION=<project-region>               # lấy ở Dashboard → Storage → S3 Configuration
S3_ACCESS_KEY=                           # S3 access key của Supabase: chỉ backend, không commit
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
S3_BUCKET_PUBLIC=vcraft-media
S3_BUCKET_PRIVATE=vcraft-private
MEDIA_PUBLIC_BASE_URL=https://<project-ref>.supabase.co/storage/v1/object/public/vcraft-media   # local: http://localhost:8080/media
# Chỉ khi STORAGE_DRIVER=local. Caddy phục vụ STORAGE_LOCAL_DIR ở /media/*; thư mục riêng tư KHÔNG được phục vụ,
# tệp trong đó chỉ đọc qua URL ký (hạn 5 phút) do API kiểm bằng STORAGE_SIGNING_KEY.
STORAGE_LOCAL_DIR=../../infra/compose/.data/media
STORAGE_LOCAL_PRIVATE_DIR=../../infra/compose/.data/private
STORAGE_SIGNING_KEY=                     # chuỗi ngẫu nhiên ≥ 16 ký tự, vd. `openssl rand -base64 32`

# ---------- Bảo mật (xác thực do Supabase Auth, xem mục Supabase bên dưới) ----------
FIELD_ENCRYPTION_KEYS=v1:base64key       # AES-256-GCM, hỗ trợ xoay khóa "v2:...,v1:..."

# ---------- Mail ----------
SMTP_URL=smtp://localhost:1025           # Mailpit khi dev
MAIL_FROM="vCraft <no-reply@vcraft.local>"

# ---------- Bản đồ ----------
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
NEXT_PUBLIC_MAP_CENTER=105.9139,20.9758   # Bát Tràng (lng,lat)

# ---------- Tùy chọn (Could) ----------
ANTHROPIC_API_KEY=                       # gợi ý viết câu chuyện / dịch vi→en

# ---------- Supabase ----------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=                     # chỉ apps/api + apps/worker, không commit
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---------- Demo / bảo vệ (GH#14, xem docs/demo/README.md) ----------
# `pnpm demo:reset` chỉ chạy khi APP_ENV=demo, NODE_ENV khác development và DEMO_RESET_CONFIRM khớp đích danh CSDL.
# `pnpm demo:media` (ảnh có giấy phép + giấy tờ mẫu) cần APP_ENV=demo hoặc development và các khóa S3_*/MEDIA_PUBLIC_BASE_URL ở trên.
# Mọi biến DEMO_* chỉ đặt trên máy/môi trường demo, KHÔNG đặt ở dev hay production.
APP_ENV=                                 # development | demo | production; rỗng = chưa khai báo (reset từ chối)
DEMO_RESET_CONFIRM=                      # gõ lại <DB_HOST>:<DB_PORT>/<DB_NAME> của CSDL sẽ bị xóa, vd. aws-0-x.pooler.supabase.com:5432/postgres
DEMO_ADMIN_PASSWORD=                     # mật khẩu bốn tài khoản demo cố định: dùng cho `pnpm demo:auth` và kịch bản e2e
DEMO_BUYER_PASSWORD=
DEMO_HOUSEHOLD_PASSWORD=
DEMO_PENDING_PASSWORD=
DEMO_API_URL=                            # tùy chọn, vd. https://<domain>/api/v1; bỏ trống thì suy từ E2E_BASE_URL
# E2E_BASE_URL=https://<host>            # origin bản đã triển khai (hoặc quick tunnel) cho `pnpm demo:e2e`

# ---------- Web gọi API phía server (tin tức công khai, vCRAFT-83g) ----------
API_INTERNAL_URL=http://localhost:4000/api/v1   # địa chỉ API mà server Next gọi; trong Docker/Caddy: http://host.docker.internal:4000/api/v1. Không gọi được thì trang /tin-tuc hiện thông báo, không lỗi
