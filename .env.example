# ---------- Chung ----------
NODE_ENV=development
APP_URL=http://localhost:8080            # origin công khai của web (Caddy hoặc Vercel) — dùng để sinh URL trong mã QR
NEXT_PUBLIC_SITE_URL=http://localhost:8080   # origin công khai của web, nhúng vào QR /q/<code> lúc build (bỏ trống: dev localhost:3000)
# USD reference price shown next to VND prices on the English site (FR-CAT-08, BR-07). The daily VND-per-USD rate is fetched by the web server (cached 24h, see apps/web/src/lib/usd-rate.ts);
# this value is only the FALLBACK used when that source is down or returns an implausible rate. VND per 1 USD, inlined at build time. Reference only; default 25000.
NEXT_PUBLIC_USD_VND_RATE=25000
# Contact for personal-data requests the account page cannot handle itself (NFR-SEC-07), shown on the privacy policy page as a mailto link.
# Download and deletion of one's own data are self-service on the account page and do not need it. Leave empty to show the generic Management Board wording.
# Inlined at build time: on Vercel set it before building (and Redeploy after changing it).
NEXT_PUBLIC_PRIVACY_EMAIL=
# Contact block in the site footer (apps/web/src/lib/contact.ts). Leave empty to keep the built-in values; inlined at build time.
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_FACEBOOK=
TZ=Asia/Ho_Chi_Minh

# ---------- Database: Postgres của Supabase qua Session pooler (ADR-15) ----------
# Lấy ở Dashboard → Connect → Session pooler. Kiểm chứng MySQL: xem README.
DB_DRIVER=postgresql                     # postgresql | mysql
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=5432                             # mysql: 3306
DB_NAME=postgres
DB_USER=postgres.<project-ref>
DB_PASSWORD=                             # mật khẩu database Supabase, không commit
DB_SSL=true                              # mysql cục bộ: false
# DB_SSL=true luôn xác thực chứng chỉ máy chủ (không có tùy chọn tắt). Pooler của Supabase dùng CA riêng (Supabase Root 2021 CA).
# Chứng chỉ CA là công khai và đã nằm trong repo: infra/certs/supabase-root-2021.crt. Đường dẫn tương đối tính từ thư mục
# chạy lệnh (packages/database, apps/api, apps/worker đều cách gốc repo hai cấp) nên dùng ../../infra/certs/...
# Chỉ đặt MỘT trong hai (bỏ trống khi máy chủ dùng chứng chỉ của CA công khai, vd. Postgres cục bộ không TLS):
DB_SSL_CA_FILE=../../infra/certs/supabase-root-2021.crt   # đường dẫn file PEM; dự án Supabase khác/CA đổi: Dashboard → Database → Settings → SSL Configuration → Download certificate
DB_SSL_CA=                               # hoặc nội dung PEM (xuống dòng viết thành \n khi để một dòng)

# Connection pool. The Supavisor SESSION pooler pins one server connection per client connection and allows only
# `pool_size` clients (15 by default, Dashboard -> Database -> Settings) per user+database, shared by the API, the
# worker, migrations, pg_cron and every dev machine. Keep each process small; the sum of all DB_POOL_MAX values
# running at once should stay below that budget. All waits are bounded, so an exhausted or silent pool turns into
# fast 503s (and GET /api/v1/health/ready fails) instead of requests that hang.
# DB_POOL_MAX=5                          # max connections of this process (API default 5; render.yaml sets the worker to 3)
# DB_POOL_MIN=0
# DB_POOL_IDLE_TIMEOUT_MS=30000          # close idle connections after this long
# DB_POOL_ACQUIRE_TIMEOUT_MS=5000        # max wait for a free connection / to open one, then 503 (PostgreSQL; MySQL: connect only)
# DB_QUERY_TIMEOUT_MS=20000              # PostgreSQL: a statement unanswered this long is hung; its connection is dropped. 0 = off
# HEALTH_READY_TIMEOUT_MS=2000           # API only: how long GET /health/ready waits for `select 1`

# ---------- Redis (cache, BullMQ, pub/sub SSE) ----------
REDIS_URL=redis://localhost:6379

# ---------- Object storage (Supabase Storage qua giao thức S3, ADR-14) ----------
STORAGE_DRIVER=s3                        # s3 | local (test, CI, demo offline: ghi vào infra/compose/.data/media)
S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_REGION=<project-region>               # lấy ở Dashboard → Storage → S3 Configuration
S3_ACCESS_KEY=                           # S3 access key của Supabase: chỉ backend, không commit
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
S3_BUCKET_PUBLIC=vcraft-media
S3_BUCKET_PRIVATE=vcraft-private
MEDIA_PUBLIC_BASE_URL=https://<project-ref>.supabase.co/storage/v1/object/public/vcraft-media   # local: http://localhost:8080/media
# Chỉ khi STORAGE_DRIVER=local. Caddy phục vụ STORAGE_LOCAL_DIR ở /media/*; thư mục riêng tư KHÔNG được phục vụ,
# tệp trong đó chỉ đọc qua URL ký (hạn 5 phút) do API kiểm bằng STORAGE_SIGNING_KEY.
STORAGE_LOCAL_DIR=../../infra/compose/.data/media
STORAGE_LOCAL_PRIVATE_DIR=../../infra/compose/.data/private
STORAGE_SIGNING_KEY=                     # chuỗi ngẫu nhiên ≥ 16 ký tự, vd. `openssl rand -base64 32`

# ---------- Bảo mật (xác thực do Supabase Auth, xem mục Supabase bên dưới) ----------
# Field-level AES-256-GCM (NFR-SEC-03): the representative's citizen ID number. Format "<keyId>:<base64 of 32 bytes>", comma-separated.
# The FIRST key encrypts, every listed key decrypts. API and worker refuse to start when it is missing or malformed; the demo seed needs it too.
# Generate: echo "v1:$(openssl rand -base64 32)". Rotate: put the new key first ("v2:...,v1:..."), run `pnpm db:rotate-field-keys`, then drop v1.
FIELD_ENCRYPTION_KEYS=v1:base64key

# ---------- Mail ----------
SMTP_URL=smtp://localhost:1025           # Mailpit khi dev
MAIL_FROM="vCraft <no-reply@vcraft.local>"

# ---------- Bản đồ ----------
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
NEXT_PUBLIC_MAP_CENTER=105.9139,20.9758   # Bát Tràng (lng,lat)
NEXT_PUBLIC_MAP_PMTILES_URL=             # GH#100: public URL of the Bát Tràng .pmtiles extract; the map falls back to it when OpenFreeMap is down

# ---------- Trợ lý Cáo (E15, ADR-19) ----------
OPENAI_API_KEY=                          # chỉ apps/api + apps/worker, không commit
OPENAI_CHAT_MODEL=gpt-6-luna             # trả lời + phân loại guardrail
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=1024         # khớp knowledge_chunks.embedding vector(1024)
ASSISTANT_ENABLED=true                   # false turns the assistant off (GH#80)
# No usage limit applies by default. Each variable below turns one limit on when set to a positive integer:
# Assistant limits are on by default with the values below; 0 turns one off.
# ASSISTANT_RATE_LIMIT_PER_MINUTE=10     # messages a minute per IP and per conversation
# ASSISTANT_RATE_LIMIT_PER_DAY=100       # messages a day per IP and per conversation
# ASSISTANT_DAILY_TOKENS=2000000         # daily token ceiling for all visitors (village day); past it "the Fox is asleep"
ASSISTANT_IP_SALT=                       # secret salt for hashed IPs in rate limits and logs; random per restart if empty

# ---------- Tùy chọn (Could) ----------
ANTHROPIC_API_KEY=                       # chỉ gợi ý viết câu chuyện / dịch vi→en; trợ lý Cáo không dùng

# ---------- Supabase ----------
AUTH_ADMIN_MFA=required                  # GH#83: admins need TOTP (aal2); `off` lifts it for local demos only
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=                     # chỉ apps/api + apps/worker, không commit
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Google sign-in for the local Supabase CLI only (GH#122); production sets it in the dashboard.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=           # GH#84: empty turns Turnstile off; test key 1x00000000000000000000AA always passes
SUPABASE_AUTH_CAPTCHA_SECRET=             # local Supabase CLI only; production sets the secret in the dashboard (docs/operations/deploy.md §6.2)

# ---------- Online payment of orders (ADR-0021, GH#205): SANDBOX ONLY ----------
# Everything is off while these are empty: no payment method is offered and production is not gated on a deposit.
# Secrets live on Render (API service) only, never on Vercel. The money goes to the village administration's bank account.
# SePay bank-account webhook (https://<domain>/api/v1/payments/webhooks/sepay, auth header "Authorization: Apikey <key>").
# All four of the first group must be set to switch bank transfer and VietQR on.
SEPAY_WEBHOOK_API_KEY=                   # secret; the API key you configure on the SePay webhook
SEPAY_BANK_NAME=                         # shown to the buyer, e.g. MB Bank
SEPAY_BANK_ACCOUNT_NUMBER=               # the account linked to SePay
SEPAY_BANK_ACCOUNT_NAME=                 # account holder, as the bank prints it
SEPAY_BANK_CODE=                         # optional: bank short name for the QR image, e.g. MBBank (empty: no QR image)
SEPAY_BANK_BIN=                          # optional: six-digit NAPAS BIN, e.g. 970422 (empty: no VietQR payload)
# SEPAY_QR_BASE_URL=https://qr.sepay.vn/img
PAYMENT_DEPOSIT_PERCENT=30               # deposit share of the order total, whole percent 1-99
PAYMENT_EXPIRES_IN_HOURS=24              # a pending payment expires after this long (the worker does it)
# PAYMENTS_DEPOSIT_REQUIRED=             # default: true once SePay is configured; production starts only after a paid deposit
# VNPay and MoMo run against their public SANDBOXES only, behind this flag. Leave it unset (off) in production.
PAYMENTS_SANDBOX_GATEWAYS=               # true shows VNPay and MoMo (needs their credentials below)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=                       # secret
# VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=                         # secret
# MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create

# ---------- Demo / bảo vệ (GH#14, xem docs/demo/README.md) ----------
# `pnpm demo:reset` chỉ chạy khi APP_ENV=demo, NODE_ENV khác development và DEMO_RESET_CONFIRM khớp đích danh CSDL.
# `pnpm demo:media` (ảnh có giấy phép + giấy tờ mẫu) cần APP_ENV=demo hoặc development và các khóa S3_*/MEDIA_PUBLIC_BASE_URL ở trên.
# Mọi biến DEMO_* chỉ đặt trên máy/môi trường demo, KHÔNG đặt ở dev hay production.
APP_ENV=                                 # development | demo | production; rỗng = chưa khai báo (reset từ chối)
DEMO_RESET_CONFIRM=                      # gõ lại <DB_HOST>:<DB_PORT>/<DB_NAME> của CSDL sẽ bị xóa, vd. aws-0-x.pooler.supabase.com:5432/postgres
DEMO_ADMIN_PASSWORD=                     # mật khẩu bốn tài khoản demo cố định: dùng cho `pnpm demo:auth` và kịch bản e2e
DEMO_BUYER_PASSWORD=
DEMO_HOUSEHOLD_PASSWORD=
DEMO_PENDING_PASSWORD=
# GH#212: sign-in usernames of the four demo accounts (defaults match the keys: admin, buyer,
# household, pending). Only set when a different handle is wanted; `demo:auth` does not read this
# (it only provisions the Supabase Auth users by email) — the web/API use it when signing in with a
# username through POST /api/v1/auth/sign-in.
DEMO_ADMIN_USERNAME=admin
# DEMO_BUYER_USERNAME=buyer
# DEMO_HOUSEHOLD_USERNAME=household
# DEMO_PENDING_USERNAME=pending
DEMO_API_URL=                            # tùy chọn, vd. https://<domain>/api/v1; bỏ trống thì suy từ E2E_BASE_URL
# E2E_BASE_URL=https://<host>            # origin bản đã triển khai (hoặc quick tunnel) cho `pnpm demo:e2e`

# ---------- Web gọi API phía server (tin tức công khai, vCRAFT-83g) ----------
API_INTERNAL_URL=http://localhost:4000/api/v1   # địa chỉ API mà server Next gọi; trong Docker/Caddy: http://host.docker.internal:4000/api/v1. Không gọi được thì trang /tin-tuc hiện thông báo, không lỗi
# Trên Vercel: https://<service>.onrender.com/api/v1. Next cũng lấy ORIGIN của biến này làm đích rewrite /api/* (next.config.ts),
# nên phải đặt trước khi build web.

# ---------- Triển khai Vercel + Render (ADR-16, docs/operations/deploy.md) ----------
# API nghe cổng API_PORT, nếu trống thì PORT (Render đặt PORT), nếu trống thì 4000; luôn nghe 0.0.0.0.
# TRUST_PROXY: number of proxy hops in front of the API (1 on Render or Caddy), or a comma-separated list of proxy IPs/CIDRs;
# false/unset trusts none. `true` is deprecated and means 1 hop (never trust-all: a client could pick its own IP).
TRUST_PROXY=false
# NFR-SEC-04: global per-IP limit of the API (needs TRUST_PROXY=1 behind a proxy to see the visitor's IP). Over it the API
# answers 429 problem+json (RATE_LIMITED) with Retry-After. /health is never limited. Defaults are generous on purpose.
# API_RATE_LIMIT_PER_MINUTE=600          # requests a minute per caller (token, else IP)
# API_RATE_LIMIT_ENABLED=true            # false turns the global limiter off
# GH#93: each live-events stream (GET /me/events) ends after this many ms and the browser reconnects; kept under
# the ~30 s Vercel rewrite limit. Raise it only where the web reaches the API without that proxy.
LIVE_EVENTS_MAX_MS=25000
# Tùy chọn: origin được gọi API chéo origin, ngăn cách bằng dấu phẩy, vd. https://vcraft.example.com. Trống = tắt CORS
# (mặc định: trình duyệt gọi /api/v1 cùng origin với web, Vercel/Caddy chuyển tiếp sang API).
CORS_ORIGINS=

# Automatic news import (apps/worker, GH#314). Off unless NEWS_IMPORT_FEEDS has a valid https feed.
NEWS_IMPORT_FEEDS=                      # "Publisher|https://feed-url;https://other-feed-url"
NEWS_IMPORT_VILLAGES=Bát Tràng
NEWS_IMPORT_CRAFTS=gốm,sứ,gốm sứ,ceramic,pottery
NEWS_IMPORT_PUBLISH=true                # false: imported stories are saved as drafts
NEWS_FILLER_MIN_PUBLISHED=6             # fewer than this in 30 days (and OPENAI_API_KEY set): evergreen filler
