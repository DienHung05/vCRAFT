{
  "name": "@vcraft/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Tầng dữ liệu hướng đối tượng: MikroORM entities, repositories, migrations theo từng driver, seeders.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@mikro-orm/core": "^7.2.5",
    "@mikro-orm/decorators": "^7.2.5",
    "@mikro-orm/migrations": "^7.2.5",
    "@mikro-orm/mysql": "^7.2.5",
    "@mikro-orm/postgresql": "^7.2.5",
    "@mikro-orm/seeder": "^7.2.5",
    "@vcraft/domain": "workspace:*",
    "@vcraft/utils": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^7.2.5",
    "@vcraft/tsconfig": "workspace:*",
    "tsdown": "^0.23.2",
    "vitest": "^5.0.5"
  },
  "files": [
    "dist",
    "src"
  ]
}
