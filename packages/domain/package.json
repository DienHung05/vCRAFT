{
  "name": "@vcraft/domain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Lõi nghiệp vụ thuần TypeScript: máy trạng thái báo giá, chiến lược chia đơn, ghép hộ phù hợp, chuỗi băm nhật ký, value objects.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {},
  "devDependencies": {
    "@vcraft/tsconfig": "workspace:*",
    "fast-check": "^4.10.2",
    "tsdown": "^0.23.2",
    "vitest": "^5.0.5"
  },
  "files": [
    "dist",
    "src"
  ]
}
