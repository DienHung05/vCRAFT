    "@nestjs/schedule": "^12.0.2",
    "@supabase/supabase-js": "^2.118.0",
    "@vcraft/database": "workspace:*",
    "@vcraft/domain": "workspace:*",
    "@vcraft/storage": "workspace:*",
    "@vcraft/utils": "workspace:*",
    "bullmq": "^6.4.2",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "^10.2.1",
    "pdf-lib": "^1.17.1",
